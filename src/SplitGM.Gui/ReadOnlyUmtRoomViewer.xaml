<UserControl x:Class="SplitGM.Gui.ReadOnlyUmtRoomViewer"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="320" MinHeight="220">
    <Grid Background="#06090E">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Padding="8,6" Background="#0D131D" BorderBrush="#26354A" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RoomSummaryText" Text="Read-only UMT room preview" Foreground="#A9B7C9"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" Text="Zoom" Margin="12,0,6,0" Foreground="#8392A8" VerticalAlignment="Center"/>
                <Slider x:Name="ZoomSlider" Grid.Column="2" Minimum="0.1" Maximum="8" Value="1"
                        TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="ZoomSlider_ValueChanged"/>
                <Button Grid.Column="3" Content="Fit" Padding="10,4" Margin="8,0,0,0" Click="FitButton_Click"/>
                <Button Grid.Column="4" Content="100%" Padding="10,4" Margin="6,0,0,0" Click="ActualSizeButton_Click"/>
                <CheckBox x:Name="GridCheckBox" Grid.Column="5" Content="Grid" Margin="10,0,0,0"
                          VerticalAlignment="Center" Foreground="#A9B7C9" Checked="GridCheckBox_Changed" Unchecked="GridCheckBox_Changed"/>
            </Grid>
        </Border>

        <ScrollViewer x:Name="RoomScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto" Background="#06090E"
                      PreviewMouseWheel="RoomScrollViewer_PreviewMouseWheel">
            <Grid x:Name="RoomSurface" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MinWidth="1" MinHeight="1">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="RoomScaleTransform" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Image x:Name="RoomImage" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                <Border x:Name="GridOverlay" IsHitTestVisible="False" Visibility="Collapsed"/>
                <TextBlock x:Name="RoomEmptyText" Text="No rendered room image is available."
                           Foreground="#8392A8" FontStyle="Italic" HorizontalAlignment="Center"
                           VerticalAlignment="Center" Margin="32"/>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
