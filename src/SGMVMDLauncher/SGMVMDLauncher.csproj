<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SGMVMDLauncher</AssemblyName>
    <RootNamespace>SGMVMDLauncher</RootNamespace>
    <Description>Required animated startup launcher for SplitGM-VM Decompiler v0.5.1.0.</Description>
    <ApplicationIcon>Resources\Brand\SGMVMDLauncher.ico</ApplicationIcon>
    <!-- Release publishing bundles the 412 JPEG resources into SGMVMDLauncher.exe. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SGMVMDLauncher.Playback\SGMVMDLauncher.Playback.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Brand\SGMVMDLauncher.ico" />
    <Resource Include="Resources\Brand\SplitGM_LauncherLogo.png" />
    <Resource Include="Resources\Brand\SGMVMDLauncher_IconSource.png" />
    <EmbeddedResource Include="Resources\Frames\frame_*.jpg">
      <LogicalName>SGMVMDLauncher.Frames.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
