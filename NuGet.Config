<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Keep SplitGM's restore isolated from incomplete/corrupted packages in the
    Windows user-wide NuGet cache. All current SplitGM/UMT dependencies are
    public packages from nuget.org.
  -->
  <config>
    <add key="globalPackagesFolder" value=".nuget/packages" />
  </config>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
